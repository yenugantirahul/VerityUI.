{
  "name": "@verityui/playwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic visual verification for frontend changes",
  "bin": {
    "verityui": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist/capture",
    "dist/cli",
    "dist/compare",
    "dist/fixture",
    "dist/persistence",
    "dist/sdk",
    "dist/verification"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "worker": "node --env-file-if-exists=.env dist/execution/worker-main.js",
    "demo": "node scripts/demo.ts",
    "cli": "node dist/cli/main.js",
    "verify:fixture": "node scripts/verify-fixture-ci.ts",
    "capture:demo": "node dist/fixture/capture-demo.js",
    "compare:demo": "node dist/fixture/compare-demo.js",
    "benchmark:compare": "node dist/fixture/compare-demo.js color --benchmark",
    "benchmark:ci": "node scripts/benchmark-ci.ts",
    "evaluate:analysis": "node scripts/evaluate-analysis.ts",
    "db:migrate": "node --env-file-if-exists=.env dist/persistence/migrate-cli.js",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.12",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
